<h1>おすすめ動画の編集</h1>

<%= form_for @movie do |f| %>
  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :movietitle, "動画タイトル" %><br>
    <%= f.text_field :movietitle, size: 40 %>
  </div>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :link, "動画リンク (YouTube URL)" %><br>
    <%= f.text_field :link, size: 60 %>
  </div>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :point, "おすすめポイント・見どころ" %><br>
    <%= f.text_area :point, size: "50x5" %>
  </div>

  <div style="margin-top: 15px;">
    <%= f.submit "動画情報を更新する" %>
  </div>
<% end %>

<br>
<%= link_to "詳細に戻る", movie_path(@movie.id) %> | 
<%= link_to "動画一覧に戻る", movies_path %>