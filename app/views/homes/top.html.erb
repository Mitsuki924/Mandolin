<!-- 🎺 メインタイトル -->
<div style="text-align: center; margin: 30px 0;">
  <h1 style="font-size: 32px; font-weight: bold; color: #1e3a8a;">Let's fun Mandolin!</h1>
  <p style="color: #64748b;">マンドリンの演奏会情報とお気に入り動画を共有しよう</p>
</div>

<hr style="margin: 20px 0; border: none; border-top: 1px solid #e2e8f0;">

<!-- 🎻 直近の演奏会セクション -->
<section style="margin-bottom: 40px;">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h2>直近の演奏会</h2>
    <%= link_to "演奏会一覧をもっと見る ≫", tweets_path, style: "color: #2563eb; text-decoration: none; font-weight: bold;" %>
  </div>

  <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
    <% if @recent_tweets.present? %>
      <% @recent_tweets.each do |t| %>
        <div style="flex: 1; min-width: 250px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <h4 style="margin-top: 0; color: #1e293b;"><%= t.title.presence || t.name %></h4>
            <p style="font-size: 14px; margin: 5px 0; color: #475569;">📅 日時：<%= t.date %></p>
            <p style="font-size: 14px; margin: 5px 0; color: #475569;">📍 場所：<%= t.place %></p>
          </div>

          <!-- ❤️ 気になる！ボタン＆詳細リンクエリア -->
          <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <% if user_signed_in? %>
                <% if current_user.already_liked?(t) %>
                  <%= button_to tweet_likes_path(t), method: :delete, style: "background: #fee2e2; border: 1px solid #fca5a5; color: #ef4444; padding: 4px 10px; border-radius: 20px; cursor: pointer; font-size: 12px; display: inline-flex; align-items: center;" do %>
                    ❤️ 気になる！済 (<%= t.likes.count %>)
                  <% end %>
                <% else %>
                  <%= button_to tweet_likes_path(t), method: :post, style: "background: #f1f5f9; border: 1px solid #cbd5e1; color: #475569; padding: 4px 10px; border-radius: 20px; cursor: pointer; font-size: 12px; display: inline-flex; align-items: center;" do %>
                    🤍 気になる！ (<%= t.likes.count %>)
                  <% end %>
                <% end %>
              <% else %>
                <%= link_to new_user_session_path, style: "background: #f1f5f9; border: 1px solid #cbd5e1; color: #94a3b8; padding: 4px 10px; border-radius: 20px; text-decoration: none; font-size: 12px; display: inline-flex; align-items: center;" do %>
                  🤍 気になる！ (<%= t.likes.count %>)
                <% end %>
              <% end %>
            </div>

            <%= link_to "詳細を見る", tweet_path(t.id), style: "font-size: 13px; color: #0284c7; text-decoration: none; font-weight: bold;" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p style="color: #94a3b8;">現在予定されている演奏会はありません</p>
    <% end %>
  </div>
</section>

<!-- 🎬 最近の演奏動画セクション -->
<section style="margin-bottom: 40px;">
  <div style="display: flex; justify-content: space-between; align-items: center;">
    <h2>最近の演奏動画</h2>
    <%= link_to "動画一覧をもっと見る ≫", movies_path, style: "color: #2563eb; text-decoration: none; font-weight: bold;" %>
  </div>

  <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
    <% if @recent_movies.present? %>
      <% @recent_movies.each do |m| %>
        <div style="flex: 1; min-width: 250px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 15px; background: #fff; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <% if m.link.present? && find_youtube_url(m.link).present? %>
              <iframe width="100%" height="150" 
                      src="https://www.youtube.com/embed/<%= find_youtube_url(m.link) %>" 
                      frameborder="0" allowfullscreen style="border-radius: 6px;">
              </iframe>
            <% end %>
            <h4 style="margin: 10px 0 5px 0; color: #1e293b;"><%= m.movietitle %></h4>
            <p style="font-size: 13px; color: #64748b;"><%= truncate(m.point, length: 30) %></p>
          </div>

          <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed #e2e8f0; text-align: right;">
            <%= link_to "詳細を見る", movie_path(m.id), style: "font-size: 13px; color: #0284c7; text-decoration: none; font-weight: bold;" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p style="color: #94a3b8;">まだ投稿された動画はありません</p>
    <% end %>
  </div>
</section>
